
PORT=3000
NODE_ENV=development

# Сгенерируй собственный случайный секрет длиной не менее 32 байт.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Укажи разрешённый адрес frontend, если используешь отдельный сервер.
FRONTEND_ORIGIN=http://localhost:5500

# Пароль первоначального администратора задавай только через безопасную
# процедуру первоначальной настройки. Не используй примерный пароль.